{
  "name": "uat-portal-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "samples": "node scripts/make-samples.mjs",
    "test:excel": "esbuild scripts/roundtrip-test.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/rt.cjs && node node_modules/.cache/rt.cjs",
    "serve:build": "node scripts/serve-build.mjs",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "demo": "npm run build:demo && vite preview --mode demo --port 4174 --strictPort"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
