<restlet scriptid="customscript_f3u_uat_api_rl">
  <description>Data API for the UAT portal app.</description>
  <isinactive>F</isinactive>
  <name>UAT Portal API</name>
  <notifyadmins>F</notifyadmins>
  <notifyemails></notifyemails>
  <notifyowner>T</notifyowner>
  <notifyuser>F</notifyuser>
  <scriptfile>[/SuiteScripts/f3u_uat_portal/f3u_uat_api_rl.js]</scriptfile>
  <scriptcustomfields>
    <scriptcustomfield scriptid="custscript_f3u_uat_enable_screenshots">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>T</defaultchecked>
      <defaultvalue></defaultvalue>
      <description></description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>CHECKBOX</fieldtype>
      <help>Copied to each new UAT cycle. Each cycle can override it.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Screenshots On By Default</label>
      <searchlevel>2</searchlevel>
      <storevalue>T</storevalue>
    </scriptcustomfield>
    <scriptcustomfield scriptid="custscript_f3u_uat_enable_email">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultvalue></defaultvalue>
      <description></description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>CHECKBOX</fieldtype>
      <help>Copied to each new UAT cycle. Each cycle can override it.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Email Alerts On By Default</label>
      <searchlevel>2</searchlevel>
      <storevalue>T</storevalue>
    </scriptcustomfield>
    <scriptcustomfield scriptid="custscript_f3u_uat_team_roles">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultvalue>administrator</defaultvalue>
      <description></description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>TEXT</fieldtype>
      <help>Optional: comma-separated role script IDs whose users count as implementation team. Use the employee list above for named people.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Implementation Team Roles</label>
      <searchlevel>2</searchlevel>
      <storevalue>T</storevalue>
    </scriptcustomfield>
    <scriptcustomfield scriptid="custscript_f3u_uat_lead_roles">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultvalue></defaultvalue>
      <description></description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>TEXT</fieldtype>
      <help>Optional: comma-separated role script IDs whose users count as UAT leads.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>UAT Lead Roles</label>
      <searchlevel>2</searchlevel>
      <storevalue>T</storevalue>
    </scriptcustomfield>
    <scriptcustomfield scriptid="custscript_f3u_uat_team_employees">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultvalue></defaultvalue>
      <description></description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>MULTISELECT</fieldtype>
      <help>Employees who can import workbooks and manage cycles, whatever role they sign in with.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Implementation Team Employees</label>
      <searchlevel>2</searchlevel>
      <selectrecordtype>-4</selectrecordtype>
      <storevalue>T</storevalue>
    </scriptcustomfield>
    <scriptcustomfield scriptid="custscript_f3u_uat_lead_employees">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultvalue></defaultvalue>
      <description></description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>MULTISELECT</fieldtype>
      <help>Employees who see the dashboard, whatever role they sign in with.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>UAT Lead Employees</label>
      <searchlevel>2</searchlevel>
      <selectrecordtype>-4</selectrecordtype>
      <storevalue>T</storevalue>
    </scriptcustomfield>
    <scriptcustomfield scriptid="custscript_f3u_uat_data_folder">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultvalue></defaultvalue>
      <description></description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>INTEGER</fieldtype>
      <help>File Cabinet folder for evidence, workbooks and backups. Blank: a top-level "F3U UAT Portal Data" folder is created.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Data Folder (internal ID)</label>
      <searchlevel>2</searchlevel>
      <storevalue>T</storevalue>
    </scriptcustomfield>
  </scriptcustomfields>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_f3u_uat_api_rl">
      <allemployees>F</allemployees>
      <allroles>T</allroles>
      <audslctrole></audslctrole>
      <isdeployed>T</isdeployed>
      <loglevel>ERROR</loglevel>
      <status>RELEASED</status>
      <title>UAT Portal API</title>
    </scriptdeployment>
  </scriptdeployments>
</restlet>
