<restlet scriptid="customscript_uat_api_rl">
  <description>Data API for the UAT portal app.</description>
  <isinactive>F</isinactive>
  <name>UAT Portal API</name>
  <notifyadmins>F</notifyadmins>
  <notifyemails></notifyemails>
  <notifyowner>T</notifyowner>
  <notifyuser>F</notifyuser>
  <scriptfile>[/SuiteScripts/uat-portal/uat_api_rl.js]</scriptfile>
  <scriptcustomfields>
    <scriptcustomfield scriptid="custscript_uat_enable_screenshots">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>T</defaultchecked>
      <defaultvalue></defaultvalue>
      <description></description>
      <displaytype>NORMAL</displaytype>
      <encryptatrest>F</encryptatrest>
      <fieldtype>CHECKBOX</fieldtype>
      <help>Copied to each new UAT cycle. Each cycle can override it.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Screenshots On By Default</label>
      <rolerestrict>F</rolerestrict>
      <searchlevel>2</searchlevel>
      <storevalue>T</storevalue>
    </scriptcustomfield>
    <scriptcustomfield scriptid="custscript_uat_enable_email">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultvalue></defaultvalue>
      <description></description>
      <displaytype>NORMAL</displaytype>
      <encryptatrest>F</encryptatrest>
      <fieldtype>CHECKBOX</fieldtype>
      <help>Copied to each new UAT cycle. Each cycle can override it.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Email Alerts On By Default</label>
      <rolerestrict>F</rolerestrict>
      <searchlevel>2</searchlevel>
      <storevalue>T</storevalue>
    </scriptcustomfield>
    <scriptcustomfield scriptid="custscript_uat_team_roles">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultvalue>administrator</defaultvalue>
      <description></description>
      <displaytype>NORMAL</displaytype>
      <encryptatrest>F</encryptatrest>
      <fieldtype>TEXT</fieldtype>
      <help>Comma-separated role script IDs that can import workbooks and manage cycles.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Implementation Team Roles</label>
      <rolerestrict>F</rolerestrict>
      <searchlevel>2</searchlevel>
      <storevalue>T</storevalue>
    </scriptcustomfield>
    <scriptcustomfield scriptid="custscript_uat_lead_roles">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultvalue></defaultvalue>
      <description></description>
      <displaytype>NORMAL</displaytype>
      <encryptatrest>F</encryptatrest>
      <fieldtype>TEXT</fieldtype>
      <help>Comma-separated role script IDs that see the dashboard.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>UAT Lead Roles</label>
      <rolerestrict>F</rolerestrict>
      <searchlevel>2</searchlevel>
      <storevalue>T</storevalue>
    </scriptcustomfield>
    <scriptcustomfield scriptid="custscript_uat_data_folder">
      <accesslevel>2</accesslevel>
      <applyformatting>F</applyformatting>
      <checkspelling>F</checkspelling>
      <defaultchecked>F</defaultchecked>
      <defaultvalue></defaultvalue>
      <description></description>
      <displaytype>NORMAL</displaytype>
      <encryptatrest>F</encryptatrest>
      <fieldtype>INTEGER</fieldtype>
      <help>File Cabinet folder for evidence, workbooks and backups. Blank: a top-level "UAT Portal Data" folder is created.</help>
      <isformula>F</isformula>
      <ismandatory>F</ismandatory>
      <label>Data Folder (internal ID)</label>
      <rolerestrict>F</rolerestrict>
      <searchlevel>2</searchlevel>
      <storevalue>T</storevalue>
    </scriptcustomfield>
  </scriptcustomfields>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_uat_api_rl">
      <allemployees>F</allemployees>
      <allpartners>F</allpartners>
      <allroles>T</allroles>
      <audslctrole></audslctrole>
      <isdeployed>T</isdeployed>
      <loglevel>ERROR</loglevel>
      <status>RELEASED</status>
      <title>UAT Portal API</title>
    </scriptdeployment>
  </scriptdeployments>
</restlet>
